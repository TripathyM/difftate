#!/usr/bin/env python3
"""difftate: open the review of this folder, starting the watcher if none runs.

Usage:
  difftate [<view>] [--base <branch>] [--open browser|nvim|both|none]
  difftate stop
  difftate status [--json] [--branch <branch>] [--base <branch>]

Run `difftate --help` for the options.
"""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib"))

from difftate.main import difftate_main  # noqa: E402

sys.exit(difftate_main(sys.argv[1:]))
