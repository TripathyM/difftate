#!/usr/bin/env python3
"""dt-export: print the export of a review, for an agent session you start.

Usage:
  dt-export [<folder>]

Prints the review's commit messages, every thread in full (open, resolved and
dismissed, with comments, replies, thread status and thread state), which
threads need an answer, and how to reply. Paste it into the agent session.
It changes nothing.

The review is that of the checked-out folder you run it in, or of <folder>:
the one difftate is running in. It asks that difftate, so one must be running.
"""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib"))

from difftate.main import export_main  # noqa: E402

sys.exit(export_main(sys.argv[1:]))
